{
  "name": "@inforahul/rn-background-location-service",
  "version": "1.0.19",
  "description": "React Native background location tracking that continues when the app is backgrounded or killed (platform permitting), when GPS and location permission are allowed",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "bin": {
    "rn-background-location-setup-permissions": "scripts/setup-native-permissions.js",
    "setup-permissions": "scripts/setup-native-permissions.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts",
    "app.plugin.js",
    "react-native.config.js",
    "InforahulRnBackgroundLocationService.podspec",
    "README.md",
    "LICENSE",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"docs/**/*.md\" \"*.md\"",
    "test": "jest",
    "pack:check": "npm pack --dry-run",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "postinstall": "node scripts/setup-native-permissions.js --postinstall",
    "setup-permissions": "node scripts/setup-native-permissions.js"
  },
  "keywords": [
    "react-native",
    "background",
    "location",
    "foreground-service",
    "corelocation",
    "offline-queue",
    "sync",
    "android",
    "ios",
    "permissions"
  ],
  "author": "inforahul",
  "license": "MIT",
  "homepage": "https://github.com/inforahul/rn-background-location-service#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inforahul/rn-background-location-service.git"
  },
  "bugs": {
    "url": "https://github.com/inforahul/rn-background-location-service/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0",
    "expo": "*",
    "expo-modules-core": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-modules-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/example/"
    ]
  }
}
